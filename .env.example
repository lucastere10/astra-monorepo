# ---------------------------------------------------------------------------
# Astra Newsletter environment variables
# Copy to `.env` at the repo root (and into apps/web and workers/collector as
# needed). Never commit real secrets.
# ---------------------------------------------------------------------------

# Database — Supabase only (Project Settings → Database → Connection string)
#
#   DATABASE_URL  → Transaction pooler (port 6543) for the app
#   DIRECT_URL    → Direct connection (port 5432) for Prisma migrations
#
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=public"

# Redis (optional — leave unset to disable cache)
# Production: Upstash, Memorystore, etc.
# REDIS_URL=""

# Auth: 32+ char secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-please-generate-a-real-secret"

# Public base URL of the web app (used for magic links and tracked URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (transactional email + magic links + newsletter delivery)
RESEND_API_KEY=""
EMAIL_FROM="Astra Newsletter <onboarding@resend.dev>"

# First admin user created by the database seed (optional)
ADMIN_EMAIL=""

# Worker: OpenAI for enrichment + embeddings
# Semantic dedup works best with real embeddings (requires OPENAI_API_KEY).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Exa Search API (optional — Exa sources are skipped when unset)
EXA_API_KEY=""

# Deduplication (worker)
DEDUP_SIMILARITY_THRESHOLD="0.92"
DEDUP_LOOKBACK_DAYS="14"
DEDUP_CANDIDATE_LIMIT="400"
