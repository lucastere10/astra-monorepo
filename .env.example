# ---------------------------------------------------------------------------
# Astra Newsletter environment variables
# Copy to `.env` at the repo root. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database — Supabase (Project Settings → Database → Connection string)
# or local Docker Postgres (`make infra`). Pick one pair of URLs below.
#
#   DATABASE_URL  → Transaction pooler (port 6543) for the web app
#   DIRECT_URL    → Direct connection (port 5432) for Prisma + collector worker
#
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=public"

# Local Docker (`make infra`) — use these instead of Supabase to run fully offline:
# DATABASE_URL="postgresql://astra:astra@127.0.0.1:5432/astra?schema=public"
# DIRECT_URL="postgresql://astra:astra@127.0.0.1:5432/astra?schema=public"

# Redis (optional — leave unset to disable cache)
# Production: Upstash, Memorystore, etc.
# Local Docker: make infra
# REDIS_URL="redis://127.0.0.1:6379"

# Auth: 32+ char secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-please-generate-a-real-secret"

# Public base URL of the web app (used for magic links and tracked URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (transactional email + magic links + newsletter delivery)
RESEND_API_KEY=""
EMAIL_FROM="Astra Newsletter <onboarding@resend.dev>"

# First admin user created by the database seed (optional)
ADMIN_EMAIL=""

# OpenAI: collector enrichment + embeddings, and newsletter intro / Why it matters
# Semantic dedup and editorial copy work best with a real API key.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Max articles to process per source per collector run
MAX_ARTICLES_PER_SOURCE="15"

# Exa Search API (optional — Exa sources are skipped when unset)
EXA_API_KEY=""

# Deduplication (worker)
DEDUP_SIMILARITY_THRESHOLD="0.92"
DEDUP_LOOKBACK_DAYS="14"
DEDUP_CANDIDATE_LIMIT="100"
